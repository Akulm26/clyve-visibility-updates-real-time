<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clyve.aeoradar.digest</string>

  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/run.sh</string>
    <string>digest</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <!-- Monday 09:00, machine-local time. Sends nothing if the queue is empty. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>__ROOT__/logs/launchd.digest.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/launchd.digest.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
