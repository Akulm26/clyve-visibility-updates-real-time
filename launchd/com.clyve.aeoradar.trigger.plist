<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clyve.aeoradar.trigger</string>

  <!-- Checks your inbox for a trigger email and runs whatever it asks for.
       Email was chosen over a watched iCloud folder because macOS privacy
       protection blocks background agents from reading iCloud Drive, and the
       only fix would be granting Full Disk Access to /bin/bash. -->
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/run.sh</string>
    <string>listen</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <!-- Every two minutes. Almost always one small IMAP round-trip that finds
       nothing and exits — no model calls, no email. -->
  <key>StartInterval</key>
  <integer>120</integer>

  <key>StandardOutPath</key>
  <string>__ROOT__/logs/launchd.trigger.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/launchd.trigger.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
